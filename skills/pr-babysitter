#!/usr/bin/env python3
"""
PR Babysitter Agent - Standalone babysitter skill implementation

This script implements the PR babysitter workflow described in the SKILL.md documentation.
It can be invoked as a standalone agent that manages PRs through review cycles.

Features:
- Checks CI status and identifies failing checks
- Analyzes unresolved review threads via GraphQL
- Handles security/dependency alerts
- Implements fix iterations with proper thread resolution
- Local Docker container deployment for review
- Notifies user when PR is ready to merge

Requirements:
- gh CLI configured for target repo
- Docker Compose environment
- Access to project files
"""

import json
import os
import subprocess
import sys
import time
from typing import Dict, List, Optional, Tuple

class PRBabysitter:
    def __init__(self, pr_number: str, repo_owner: str, repo_name: str,
                 iteration_cap: int = 12, security_hold: bool = True):
        self.pr_number = pr_number
        self.repo_owner = repo_owner
        self.repo_name = repo_name
        self.iteration_cap = iteration_cap
        self.security_hold = security_hold
        self.branch_name = f"babysitter-pr-{pr_number}"
        self.last_state: Dict = {}
        self.graphql_query_mutation = """
query($owner: String!, $repo: String!, $pr: Int!) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $pr) {
      reviewThreads(first: 100) {
        nodes {
          id
          isResolved
          isOutdated
          path
          line
          comments(first: 5) {
            nodes {
              body
              author { login }
              createdAt
            }
          }
        }
      }
    }
  }
}
"""

    def run_cmd(self, cmd: list, capture_output: bool = False) -> subprocess.CompletedProcess:
        """Run a command with appropriate error handling"""
        try:
            return subprocess.run(
                cmd,
                capture_output=capture_output,
                text=True,
                check=True
            )
        except subprocess.CalledProcessError as e:
            print(f"Command failed: {' '.join(cmd)}")
            print(f"Error: {e.stderr}")
            raise

    def run_cmd_capture(self, cmd: list) -> str:
        """Run a command and return stdout"""
        result = self.run_cmd(cmd, capture_output=True)
        return result.stdout.strip()

    def get_ci_status(self) -> List[Dict]:
        """Get current CI check status for the PR"""
        print(f"Checking CI status for PR #{self.pr_number}")
        try:
            result = self.run_cmd_capture([
                "gh", "pr", "checks", self.pr_number,
                "--repo", f"{self.repo_owner}/{self.repo_name}"
            ])

            # Parse JSON output
            checks_data = json.loads(result)
            failures = []
            for check in checks_data.get('checks', []):
                if check.get('conclusion') == 'failure':
                    failures.append({
                        'name': check.get('label', 'Unknown'),
                        'log': self.get_failing_log_tail(check['checkRun']['databaseId'])
                    })
            return failures
        except Exception as e:
            print(f"Error fetching CI status: {e}")
            return []

    def get_failing_log_tail(self, run_id: str) -> str:
        """Get the tail of failing log output"""
        try:
            log_output = self.run_cmd_capture([
                "gh", "run", "view", run_id,
                "--repo", f"{self.repo_owner}/{self.repo_name}",
                "--log-failed"
            ])
            # Extract last few lines of log
            lines = log_output.split('\n')
            return '\n'.join(lines[-10:] if len(lines) > 10 else lines)
        except:
            return "Log retrieval failed"

    def get_review_threads(self) -> List[Dict]:
        """Get unresolved review threads via GraphQL"""
        print(f"Fetching review threads for PR #{self.pr_number}")
        try:
            # Build GraphQL query
            query = self.graphql_query_mutation.replace(
                "{owner}", self.repo_owner
            ).replace("{repo}", self.repo_name).replace("{pr}", str(self.pr_number))

            result = self.run_cmd_capture([
                "gh", "api", "graphql",
                "-f", f"query={query}"
            ])

            # Parse the response
            data = json.loads(result)
            threads = []
            pr_data = data.get('data', {}).get('repository', {}).get('pullRequest', {})
            if not pr_data:
                return []

            review_threads = pr_data.get('reviewThreads', {}).get('nodes', [])
            for thread in review_threads:
                if not thread.get('isResolved') and not thread.get('isOutdated'):
                    comments = thread.get('comments', {}).get('nodes', [])
                    body = comments[0].get('body', '') if comments else ""
                    author = thread.get('comments', {}).get('nodes', [{}])[0].get('author', {}).get('login', '')
                    path = thread.get('path', '')
                    line = thread.get('line', 0)

                    threads.append({
                        'id': thread.get('id'),
                        'path': path,
                        'line': line,
                        'body': body,
                        'author': author
                    })
            return threads
        except Exception as e:
            print(f"Error fetching review threads: {e}")
            return []

    def get_dependabot_alerts(self) -> List[Dict]:
        """Check for open Dependabot/security alerts related to this PR"""
        print(f"Checking Dependabot alerts for PR #{self.pr_number}")
        try:
            result = self.run_cmd_capture([
                "gh", "api", "repos", f"{self.repo_owner}/{self.repo_name}",
                "/dependabot/alerts"
            ])

            alerts_data = json.loads(result)
            alerts = []
            modified_files = self.get_modified_files()

            for alert in alerts_data.get('alerts', []):
                if self.is_alert_related_to_pr(alert, modified_files):
                    alerts.append({
                        'package': alert.get('package', {}).get('name', ''),
                        'severity': alert.get('severity', ''),
                        'summary': alert.get('summary', ''),
                        'html_url': alert.get('html_url', '')
                    })
            return alerts
        except Exception as e:
            print(f"Error checking Dependabot alerts: {e}")
            return []

    def get_modified_files(self) -> List[str]:
        """Get list of files modified in the current PR"""
        try:
            result = self.run_cmd_capture([
                "git", "diff", "--name-only", "HEAD~1", "HEAD"
            ])
            return result.split('\n') if result else []
        except:
            # Fallback method
            try:
                result = self.run_cmd_capture([
                    "git", "diff", "--name-only",
                    "--diff-filter=AM", "origin/main", "HEAD"
                ])
                return result.split('\n') if result else []
            except:
                return [""]  # Assume modified files if we can't determine

    def is_alert_related_to_pr(self, alert: Dict, modified_files: List[str]) -> bool:
        """Check if a Dependabot alert affects files in this PR"""
        alert_files = alert.get('alert_affected_files', [])
        for alert_file in alert_files:
            for mod_file in modified_files:
                if alert_file == mod_file:
                    return True
        return bool(alert_files)  # If any files are mentioned, it's related

    def build_fix_prompt(self, ci_fails: List[Dict],
                        review_threads: List[Dict],
                        security_alerts: List[Dict]) -> str:
        """Build the fix prompt according to the template"""
        print("Building fix prompt...")

        # CI failures section
        ci_section = "## Failing CI checks\n"
        for fail in ci_fails:
            ci_section += f"- Check: {fail['name']}\n  Log:\n```\n{fail['log']}\n```\n\n"

        # Review threads section
        rt_section = "## Unresolved review feedback\n"
        for thread in review_threads:
            rt_section += f"- Thread ID: {thread['id']}\n"
            rt_section += f"  File: {thread['path']}:{thread['line']}\n"
            rt_section += f"  Author: {thread['author']}\n"
            rt_section += f"  Body: {thread['body']}\n\n"

        # Security alerts section
        sec_section = "## Open security/dependency alerts\n"
        for alert in security_alerts:
            sec_section += f"- Package: {alert['package']}\n"
            sec_section += f"  Severity: {alert['severity']}\n"
            sec_section += f"  Summary: {alert['summary']}\n\n"

        # Full prompt
        prompt_template = """
You are fixing PR #{pr_number} in {repo_owner}/{repo_name} (branch: {branch}) so it can merge.

{ci_section}
{rt_section}
{sec_section}

## Instructions
- Fix the root cause, not just the symptom. If multiple failing checks share one cause, fix it once.
- Do not touch files unrelated to these failures/comments.
- If a review comment is a question rather than a directive, answer it in your commit message or code comment rather than guessing at a code change.
- If a finding touches auth, crypto, secrets, or permissions logic: make the minimal safe fix if obvious, but flag it clearly in your output as security-sensitive rather than silently pushing a substantive change to that logic.
- Commit with a message describing what was fixed and why, referencing the check/thread it addresses.

FIX PROMPT:
"""

        return prompt_template.format(
            pr_number=self.pr_number,
            repo_owner=self.repo_owner,
            repo_name=self.repo_name,
            branch=self.branch_name,
            ci_section=ci_section,
            rt_section=rt_section,
            sec_section=sec_section
        )

    def execute_fix(self, fix_prompt: str) -> bool:
        """Execute the fix using Claude/Claude Code"""
        print("Executing fix with Claude Code...")
        try:
            # This would normally invoke Claude Code or another agent
            # For this standalone implementation, we'll simulate the process
            # In a real implementation, this would use the appropriate API

            print("Fix execution simulated - would invoke Claude/CLI tools here")
            # Simulate successful fix
            time.sleep(1)
            return True
        except Exception as e:
            print(f"Fix execution failed: {e}")
            return False

    def resolve_thread(self, thread_id: str) -> bool:
        """Resolve a review thread via GraphQL mutation"""
        print(f"Resolving thread {thread_id}...")
        try:
            mutation_query = """
mutation($threadId: ID!) {
              resolveReviewThread(input: {threadId: $threadId}) {
                thread { id }
              }
            }
            """

            self.run_cmd([
                "gh", "api", "graphql",
                "-f", f"query={mutation_query.replace('{threadId}', {thread_id})}"
            ])
            print(f"Successfully resolved thread {thread_id}")
            return True
        except Exception as e:
            print(f"Failed to resolve thread {thread_id}: {e}")
            return False

    def check_stuck_state(self) -> bool:
        """Check if we're stuck in a loop with identical failure states"""
        if not self.last_state:
            # First iteration - no previous state to compare
            self.last_state = {
                'fails': self.get_ci_failures(),
                'threads': [t['id'] for t in self.get_review_threads()],
                'alerts': len(self.get_dependabot_alerts())
            }
            return False

        # Compare current state with last state
        current_fails = [f['name'] for f in self.get_ci_failures()]
        current_threads = [t['id'] for t in self.get_review_threads()]
        current_alerts = len(self.get_dependabot_alerts())

        if (current_fails == self.last_state['fails'] and
            current_threads == self.last_state['threads'] and
            current_alerts == self.last_state['alerts']):
            print("Stuck state detected - no progress from last iteration")
            return True

        # Update last state
        self.last_state = {
            'fails': current_fails,
            'threads': current_threads,
            'alerts': current_alerts
        }
        return False

    def deploy_locally(self):
        """Deploy the PR branch locally via Docker Compose for review"""
        print(f"Deploying PR #{self.pr_number} locally...")
        try:
            # Checkout the PR branch
            self.run_cmd([
                "git", "fetch", "origin", self.branch_name
            ])
            self.run_cmd([
                "git", "checkout", self.branch_name
            ])

            # Stop any existing containers
            self.run_cmd_capture(["docker", "compose", "down"])

            # Build and start containers
            self.run_cmd_capture(["docker", "compose", "build"])
            self.run_cmd_capture(["docker", "compose", "up", "-d"])

            # Show running services
            self.run_cmd_capture(["docker", "compose", "ps"])

            print(f"Successfully deployed PR #{self.pr_number} locally")
            print("Services are now running and ready for review")
        except Exception as e:
            print(f"Deployment failed: {e}")

    def cleanup(self):
        """Clean up local resources"""
        try:
            self.run_cmd_capture(["docker", "compose", "down"])
            print("Cleaned up Docker containers")
        except:
            pass

    def run(self) -> None:
        """Main babysitter workflow loop"""
        print(f"Starting PR Babysitter for PR #{self.pr_number}")
        iteration = 0

        try:
            while iteration < self.iteration_cap:
                print(f"\n=== Iteration {iteration + 1} ===")

                # Step 1: Gather PR state
                ci_fails = self.get_ci_status()
                review_threads = self.get_review_threads()
                security_alerts = self.get_dependabot_alerts()
                modified_files = self.get_modified_files()

                print(f"CI failures: {len(ci_fails)}")
                print(f"Review threads: {len(review_threads)}")
                print(f"Security alerts: {len(security_alerts)}")

                # Step 2: Check for stuck state
                if self.check_stuck_state():
                    print("⚠️  Stuck in failure loop after multiple attempts")
                    break

                # Step 3: Check if PR is ready to merge (all conditions met)
                if (len(ci_fails) == 0 and
                    len(review_threads) == 0 and
                    len(security_alerts) == 0):
                    print("✅ PR conditions met - ready for local deployment")

                    # Deploy locally for review
                    self.deploy_locally()

                    # Notify user
                    self.notify_success()
                    return

                # Step 4: Build and execute fix if needed
                if ci_fails or review_threads or security_alerts:
                    fix_prompt = self.build_fix_prompt(ci_fails, review_threads, security_alerts)
                    print("🔧 Building fix prompt and executing fix...")
                    fix_success = self.execute_fix(fix_prompt)

                    if fix_success:
                        # Resolve any addressed threads
                        for thread in review_threads:
                            self.resolve_thread(thread['id'])

                    # Check if we have new commits to push
                    try:
                        self.run_cmd_capture(["git", "diff", "--cached"])
                        self.run_cmd_capture(["git", "commit", "-m", "Auto-fix babysitter iteration"])
                        self.run_cmd_capture(["git", "push", "origin", self.branch_name])
                        print("📤 Pushed fixes to PR branch")
                    except:
                        print("No changes to push or git not available")

                # Wait before next iteration (60s default)
                print("💤 Waiting 60s before next check...")
                time.sleep(30)  # Shorter for demo purposes
                iteration += 1

            print("❌ Iteration cap reached - aborting")
            self.notify_stuck()

        except KeyboardInterrupt:
            print("Interrupted by user")
            self.cleanup()
            sys.exit(0)
        except Exception as e:
            print(f"Unexpected error: {e}")
            self.cleanup()
            raise

    def notify_success(self):
        """Notify user that PR is ready to merge"""
        print("🎉 SUCCESS: PR is ready for review and merging!")
        print(f"PR #{self.pr_number} has been processed successfully.")
        print("Local Docker containers are running for final review.")
        print("You can now merge this PR when satisfied.")

    def notify_stuck(self):
        """Notify user about stuck state"""
        print("❌ FAILURE: PR requires manual intervention")
        print("The babysitter detected a persistent failure state that couldn't be resolved automatically.")
        print("Please check the PR manually at:")
        print(f"https://github.com/{self.repo_owner}/{self.repo_name}/pull/{self.pr_number}")

    def notify_security_hold(self, sensitive_findings):
        """Notify user about security-sensitive findings"""
        if sensitive_findings:
            print("⚠️  SECURITY SENSITIVE FINDINGS DETECTED")
            print("The babysitter encountered security-sensitive changes that require manual review.")
            print("These findings were identified but not automatically fixed due to safety policies.")
            print("Please review these manually:")
            for finding in sensitive_findings:
                print(f"  - {finding}")


