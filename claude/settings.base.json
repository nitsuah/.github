{
  "permissions": {
    "allow": [
      "Bash(docker ps)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "PowerShell(Set-Location {{CODE}})",
      "Read('{{CODE}}\\**')",
      "Grep('{{CODE}}\\**')",
      "Bash(git status*)",
      "PowerShell(git status*)"
    ],
    "additionalDirectories": [
      "{{CODE}}"
    ],
    "allowedMcpServers": [
      {
        "serverName": "windirstat-mcp",
        "serverCommand": [
          "node",
          "{{CODE}}\\windirstat-mcp\\mcp-server.js"
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"{{CLAUDE}}\\hooks\\peon-ping\\peon.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"{{CLAUDE}}\\hooks\\peon-ping\\peon.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"{{CLAUDE}}\\hooks\\peon-ping\\peon.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"{{CLAUDE}}\\hooks\\peon-ping\\scripts\\hook-handle-use.ps1\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "RemoteTrigger|mcp__scheduled-tasks__run_scheduled_task",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"{{CLAUDE}}\\hooks\\routine-guard\\guard.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": false,
    "auth0@claude-plugins-official": false,
    "small-business@knowledge-work-plugins": false,
    "productivity@knowledge-work-plugins": false,
    "marketing@knowledge-work-plugins": false,
    "finance@knowledge-work-plugins": false,
    "sales@knowledge-work-plugins": false,
    "legal@knowledge-work-plugins": false,
    "operations@knowledge-work-plugins": false,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "customer-support@knowledge-work-plugins": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "stripe@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true,
  "statusLine": {
    "type": "command",
    "command": "node \"{{KIT}}/imps/statusline.mjs\"",
    "refreshInterval": 5
  }
}
